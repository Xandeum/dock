[Unit]
Description=Xandeum Dock Vega Service
After=network.target

[Service]
ExecStart=/usr/bin/xandeum-dock --version vega
WorkingDirectory=/home/sol/xand/dock
Restart=always
User=sol
Environment=NODE_ENV=production
Environment=RUST_LOG=info
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=xandeum-dock-vega

[Install]
WantedBy=multi-user.target





