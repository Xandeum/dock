[Unit]
Description=Xandeum Dock Altair Service
After=network.target

[Service]
ExecStart=/usr/bin/xandeum-dock --version altair
Restart=always
User=sol
Environment=NODE_ENV=production
Environment=RUST_LOG=info
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=xandeum-dock-altair

[Install]
WantedBy=multi-user.target





